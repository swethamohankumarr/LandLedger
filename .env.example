# ----------------------------------------------------------------------------
# ROOT (Hardhat / deployment / seeding) — copy to .env and fill in.
# NEVER commit the real .env. Only the contract address is public.
# ----------------------------------------------------------------------------

# --- Sepolia deployment (optional; local Hardhat needs none of these) ---
# JSON-RPC endpoint, e.g. from Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer private key (the account must be funded with Sepolia test ETH).
# This wallet becomes DEFAULT_ADMIN_ROLE + first REGISTRAR_ROLE.
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# For `hardhat verify` on Etherscan.
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- IPFS via Pinata (optional; seed falls back to a logged local mock) ---
# A Pinata JWT with pinFileToIPFS permission. Used ONLY by server-side
# scripts (scripts/seed.ts) and the Vercel function (frontend/api/pin.ts).
PINATA_JWT=

# Public IPFS gateway used to render documents (safe to expose).
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Turn gas reporting on during tests.
REPORT_GAS=false

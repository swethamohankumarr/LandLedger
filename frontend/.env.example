# ----------------------------------------------------------------------------
# FRONTEND env — copy to .env.local for dev, or set in Vercel for production.
# Only PUBLIC values belong here (anything VITE_* is shipped to the browser).
# ----------------------------------------------------------------------------

# Deployed contract address. If unset, the address baked into
# src/contracts/landRegistry.ts by the deploy/seed script is used.
VITE_CONTRACT_ADDRESS=

# Expected chain id (11155111 = Sepolia, 31337 = Hardhat localhost).
VITE_CHAIN_ID=11155111

# Public IPFS gateway for rendering documents.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: a public read-only RPC so the Public Verify page works with no wallet.
VITE_PUBLIC_RPC_URL=https://rpc.sepolia.org

# ----------------------------------------------------------------------------
# SERVER-ONLY (NOT exposed to the browser) — used by api/pin.ts on Vercel.
# ----------------------------------------------------------------------------
PINATA_JWT=
